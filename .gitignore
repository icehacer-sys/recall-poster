# Secrets — never commit
.env
.env.*
!.env.example
# Google OAuth client downloads (YouTube sign-in). Keep them OUTSIDE this public repo.
client_secret*.json
*.client_secret.json

# Deps + build
node_modules/
dist/

# Logs / OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# NOTE: posts/ and state.json are intentionally TRACKED.
# Slide images must be public (raw.githubusercontent.com) for Meta to fetch them,
# and state.json is committed back by the runner so restarts never double-post.

# Comment bot (comments/): private state never goes to this PUBLIC repo. The cloud keeps it
# encrypted in the Actions cache (see .github/workflows/comments.yml).
/comments/state.json
/comments/review-queue.json
/comments/review-queue.cloud.json
/comments/spend.json
/comments/cloud-state.enc
/comments/logs/
/comments/reports/*live*
/comments/reports/*dry*
/comments/.orig-from-ig-bot/
# YouTube comment bot (youtube-comments.yml): same rule, yt-* files in the encrypted Actions cache only.
/comments/yt-state.json
/comments/yt-review-queue.json
/comments/yt-review-queue.cloud.json
/comments/yt-spend.json
/comments/yt-quota.json
/comments/yt-cloud-state.enc
logs/
