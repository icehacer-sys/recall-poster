# Copy to .env and fill in. .env is gitignored. Never commit real tokens.

# --- Secrets ---
# Claude for Startups key for drafting replies. Read at run time from BOT_CLAUDE_ENV_FILE
# (default W:/Projects/recall-engine/.env.local) or from CLAUDE_API_KEY here. Never copy it in.
# ANTHROPIC_API_KEY is ignored on purpose.
# BOT_CLAUDE_ENV_FILE=W:/Projects/recall-engine/.env.local
# BOT_DAILY_MODEL_CALLS=40
# BOT_MONTHLY_USD=5
# Long-lived Instagram token for @recallengine (Instagram API with Instagram Login, graph.instagram.com).
# Scopes: instagram_business_basic, instagram_business_content_publish, instagram_business_manage_comments.
# Create it with npm run token:url then npm run token -- <code> (writes this line for you). About 60 days.
IG_ACCESS_TOKEN=

# --- Only for npm run token (Meta app dashboard > Instagram > API setup with Instagram login) ---
IG_CLIENT_ID=
IG_CLIENT_SECRET=
IG_REDIRECT_URI=https://recallengine.app/

# --- Tuning (safe, LOW defaults shown) ---
# BOT_MODEL=claude-sonnet-5-5
# BOT_MAX_MODEL_CALLS=40          # hard ceiling per run
# BOT_PER_REEL_DAILY_CAP=20       # replies per reel per Cairo day
# BOT_DAILY_CAP=40                # replies per Cairo day in total
# BOT_PER_THREAD_CAP=1            # replies per comment thread
# BOT_WINDOW_HOURS=72             # only reels from the last N hours
# BOT_MAX_POSTS=5
# BOT_ACTIVE_TZ=Africa/Cairo
# BOT_ACTIVE_WINDOWS=19-2         # live replies only 19:00 to 02:00 Cairo
# BOT_EDUCATIONAL=on              # off = wrong-guess nudges go to the owner list too
# BOT_CASE_QUESTIONS=on           # off = questions about the case go to the owner list with a draft
# BOT_POSTER_STATE=../recall-poster/state.json   # maps published reels to their facts

# Required to post replies. Must equal "yes". Leave empty until the owner says GO.
BOT_CONFIRM_LIVE=
